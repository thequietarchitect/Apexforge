{
  "name": "apexforge-language",
  "displayName": "ApexForge Language",
  "description": "ApexForge .apex file recognition, editor behavior, and TextMate syntax highlighting.",
  "version": "0.1.0",
  "publisher": "gravitas-studios",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "apexforge",
    "apex",
    "language",
    "dsl"
  ],
  "contributes": {
    "languages": [
      {
        "id": "apexforge",
        "aliases": [
          "ApexForge",
          "apexforge"
        ],
        "extensions": [
          ".apex"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "configurationDefaults": {
      "[apexforge]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 4,
        "editor.detectIndentation": false
      }
    },
    "grammars": [
      {
        "language": "apexforge",
        "scopeName": "source.apexforge",
        "path": "./syntaxes/apexforge.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "apexforge.showLanguageServerOutput",
        "title": "ApexForge: Show Language Server Output"
      },
      {
        "command": "apexforge.restartLanguageServer",
        "title": "ApexForge: Restart Language Server"
      }
    ],
    "configuration": {
      "title": "ApexForge Language Server",
      "properties": {
        "apexforge.languageServer.pythonCommand": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Python launcher used for the ApexForge language server. Leave empty to use py on Windows or python3 elsewhere."
        },
        "apexforge.languageServer.serverPath": {
          "type": "string",
          "default": "apexforge/apexforge_lsp.py",
          "scope": "resource",
          "description": "Workspace-relative or absolute path to the ApexForge language-server entry point."
        },
        "apexforge.languageServer.trace": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Write document synchronization and protocol lifecycle details to the ApexForge Language Server output channel."
        }
      }
    }
  },
  "main": "./extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onLanguage:apexforge",
    "workspaceContains:apexforge/apexforge_lsp.py"
  ]
}
